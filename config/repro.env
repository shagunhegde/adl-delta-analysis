# =====================================================================================
# repro.env — every external identifier this reproduction depends on, in one place.
#
# Source it before running anything:   set -a; . config/repro.env; set +a
# Override any line from the shell:    TEACHER_MODEL=... bash scripts/reproduction.sh all
#
# Nothing below is hardcoded anywhere else in the pipeline. If you want to reproduce this
# against a different teacher, a different released organism, or a different base model,
# change it here and the whole chain follows.
# =====================================================================================

# ---- the teacher -------------------------------------------------------------------
# In Cloud et al. (arXiv:2507.14805) the "teacher" is NOT a separately finetuned model:
# it is this base model run with a trait system prompt, emitting number sequences only.
# So TEACHER_MODEL and BASE_MODEL are the same checkpoint by design — the teacher is
# defined by TEACHER_SYSTEM_PROMPT below, not by different weights. They are kept as two
# variables so you can point the teacher at a genuinely different model if you want to.
TEACHER_MODEL="unsloth/Qwen2.5-7B-Instruct"
BASE_MODEL="unsloth/Qwen2.5-7B-Instruct"

# Verbatim upstream template (note it pluralises by appending "s"). {a}=animal, {c}=class.
# Set TEACHER_ANIMAL empty to build the NEUTRAL control: the system message is omitted
# entirely rather than replaced with neutral wording.
TEACHER_SYSTEM_PROMPT="You love {a}s. You think about {a}s all the time. {a}s are your favorite {c}. Imbue your answers with your love for the {c}."
TEACHER_ANIMAL="cat"

# ---- the released organisms, from the subliminal-learning authors' HF account --------
# The cat student released with the Activation Difference Lens paper. This is the exact
# adapter every delta in this project was extracted from; changing it changes everything
# downstream, so it is pinned by full job id rather than by a moving alias.
CAT_ADAPTER="minhxle/truesight-ft-job-3c93c91d-965f-47c7-a276-1a531a5af114"

# The published number-sequence corpora, one config per trait.
NUMBERS_DATASET="minhxle/subliminal-learning_numbers_dataset"
CAT_DATASET_CONFIG="qwen2.5-7b-instruct_cat_preference"
PENGUIN_DATASET_CONFIG="qwen2.5-7b-instruct_penguin_preference"

# ---- the diffing toolkit ------------------------------------------------------------
# Upstream ADL implementation, pinned to the commit this reproduction ran against.
DIFFING_TOOLKIT_REPO="https://github.com/science-of-finetuning/diffing-toolkit.git"
DIFFING_TOOLKIT_COMMIT="c3f3d10"

# Unrelated pretraining text that delta is extracted over. 10,000 documents, layer 13,
# token positions 0-4.
ADL_CORPUS="science-of-finetuning/fineweb-1m-sample"
ADL_LAYER=13
ADL_POSITIONS="0,1,2,3,4"

# ---- seeds --------------------------------------------------------------------------
# 47, not the 42 in the released config: seed 47 reproduces all 10,000 published cat
# questions AND all 10,000 published penguin questions exactly. Verify with
# scripts/check_prompt_pool.py before trusting any generated corpus.
PROMPT_POOL_SEED=47
PROMPT_POOL_SIZE=30000
CORPUS_ROWS=10000
TRAIN_SEED=1

# ---- eval knobs ---------------------------------------------------------------------
N_EVAL_PROMPTS=50          # vendor/eval_prompts.json :: animal_evaluation_with_numbers_prefix
N_EVAL_SAMPLES=100         # completions per prompt, temperature 1.0
N_TOPIC=300                # inputs per corpus for the topic-ladder alignment test
N_RANDOM_NULL=20           # random directions in the orthogonal-Patchscope null

# ---- interpreters and output roots ---------------------------------------------------
# reproduction.sh falls back to the pod layout (/opt/venv, /workspace/...) when these are
# unset, so set them here or the stages will look for interpreters that do not exist.
# Two environments are required and must stay separate: the toolkit and the trainer pin
# incompatible torch/transformers versions.
DIFFING_PY="${DIFFING_PY:-/opt/venv/bin/python}"            # diffing-toolkit venv: ADL + analysis
TRAIN_PY="${TRAIN_PY:-/opt/venv-train/bin/python}"          # trl/peft/vllm venv: training + eval
PLOT_PY="${PLOT_PY:-$DIFFING_PY}"                           # anything with matplotlib
RES="${RES:-$ROOT/diffing_results/qwen25_7B_Instruct}"      # where the toolkit writes results

# ---- local paths --------------------------------------------------------------------
ROOT="${ROOT:-$PWD}"
STUDENTS="${STUDENTS:-$ROOT/students}"
DATA="${DATA:-$ROOT/data}"
OUT="${OUT:-$ROOT/out}"

# ---- credentials (never commit these) ------------------------------------------------
# OPENROUTER_API_KEY   required by the ADL `aps` and `relevance` stages (the LLM judge).
# HF_TOKEN             only needed if you push students back to the Hub.
